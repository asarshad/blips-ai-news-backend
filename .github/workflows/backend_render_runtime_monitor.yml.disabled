name: Backend (Render runtime monitor)

on:
  workflow_dispatch:
    inputs:
      recent_hours:
        description: Hours of Render events to inspect
        required: false
        default: "24"
  schedule:
    - cron: "15 * * * *"

permissions:
  contents: read

jobs:
  monitor:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Check Render worker runtime events
        env:
          RENDER_API_TOKEN: ${{ secrets.RENDER_API_TOKEN }}
          ALERT_WEBHOOK_URL: ${{ secrets.ALERT_WEBHOOK_URL }}
          WORKER_SERVICE_ID: ${{ vars.RENDER_WORKER_SERVICE_ID || 'srv-d6hvve8gjchc73d0cq70' }}
        run: |
          set -euo pipefail

          if [ "${{ github.event_name }}" = "schedule" ]; then
            recent_hours=1
            alert_max_age_minutes=70
          else
            recent_hours="${{ inputs.recent_hours || '24' }}"
            alert_max_age_minutes=""
          fi

          args=(
            src/backend/scripts/render_runtime_check.py
            --service-id "$WORKER_SERVICE_ID"
            --recent-hours "$recent_hours"
            --fail-on-anomaly
            --pretty
          )
          if [ -n "$alert_max_age_minutes" ]; then
            args+=(--alert-max-age-minutes "$alert_max_age_minutes")
          fi

          python "${args[@]}"
