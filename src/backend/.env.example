# Blips Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real values - it contains secrets

# =============================================================================
# REQUIRED - Core Infrastructure
# =============================================================================

# Database connection (Render Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/blips

# Redis connection (Render Redis or local)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# REQUIRED - LLM Provider
# =============================================================================

# Which LLM provider to use: "openai" or "mistral"
LLM_PROVIDER=openai

# OpenAI Configuration
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Mistral Configuration (alternative to OpenAI)
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment: dev, prod
ENV=dev

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# SECURITY
# =============================================================================

# Admin API key for /admin and /debug routes (required, fail-closed if empty)
ADMIN_API_KEY=your-admin-api-key-here

# Enable debug diagnostic routes locally if needed (default: false in prod)
DEBUG_ROUTES_ENABLED=true

# Enable Swagger UI + ReDoc interactive docs locally if needed (default: false in prod)
DOCS_ENABLED=true

# Comma-separated list of CORS allowed origins.
# If empty, the app falls back to capacitor://localhost and http://localhost.
CORS_ORIGINS=capacitor://localhost,http://localhost,http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=10/minute

# =============================================================================
# INGESTION SETTINGS
# =============================================================================

# Preferred continuous-ingestion cadence. Scheduler clamps this into 5-15 minutes.
INGESTION_SCHEDULER_MINUTES=15

# Backward-compatible fallback if INGESTION_SCHEDULER_MINUTES is unset.
NEWS_FETCH_INTERVAL_MINUTES=15

# Legacy fallback; kept for compatibility but not recommended for tuning cadence.
NEWS_FETCH_INTERVAL_HOURS=3

# Maximum items to process per ingestion run
MAX_ITEMS_PER_RUN=100

# Maximum LLM calls to make in one retry run
MAX_LLM_CALLS_PER_RUN=50

# Delay between LLM calls in seconds (rate limiting)
LLM_RATE_LIMIT_DELAY=0.5

# Scheduler / worker toggles
SCHEDULER_ENABLED=true
INGESTION_ENABLED=true
INGESTION_CRON_DISABLED=false
INGESTION_MAX_WORKERS=1
INGEST_UNTIL_TARGETS=true
INGEST_CATCHUP_MAX_SECONDS=1800
RSS_ENTRIES_PER_FEED=50
YT_VIDEOS_PER_CHANNEL=30
YT_CURATED_LOOKBACK_HOURS=168
YOUTUBE_CURATED_ONLY=false
YOUTUBE_DISCOVERY_ENABLED=true
DISCOVERY_SIGNAL_ENABLED=true
DISCOVERY_SIGNAL_LIMIT=25
DISCOVERY_SIGNAL_PER_SOURCE_LIMIT=5

# Daily reel target budget
DAILY_TARGET_ARTICLES=100
DAILY_TARGET_VIDEOS=60
DAILY_TARGET_REELS=40

# Optional per-feed target overrides (JSON map).
# This sample override is utility-first and intentionally leaves discovery headroom.
INGESTION_TARGET_DEFAULTS={"youtube_reel:The Verge":4,"youtube_reel:Technology Connections Shorts":4,"youtube_reel:Karl Conrad":3,"youtube_reel:SuperSaf":3,"youtube_reel:Sam Beckman":3,"youtube_reel:Mrwhosetheboss":3,"youtube_reel:Unbox Therapy":3,"youtube_reel:JerryRigEverything":3,"youtube_reel:Marques Brownlee (MKBHD)":2,"youtube_reel:ShortCircuit":1,"youtube_reel:TechLinked":1,"youtube_reel:Android Developers":0,"youtube_reel:Tech Vision":0,"youtube_reel:Linus Tech Tips":0,"youtube_reel:Fireship":0,"youtube_reel:Matt Wolfe":0,"youtube_reel:Jeff Geerling":0,"youtube_video:Marques Brownlee (MKBHD)":2,"youtube_video:ShortCircuit":3,"youtube_video:TechLinked":2}

# Advanced YouTube discovery / quota controls
YOUTUBE_SEARCH_MIN_INTERVAL_MINUTES=180
YOUTUBE_VIDEO_SEARCH_MIN_INTERVAL_MINUTES=180
YOUTUBE_REEL_SEARCH_MIN_INTERVAL_MINUTES=180
YOUTUBE_SEARCH_MIN_VIDEO_DEFICIT=1
YOUTUBE_SEARCH_MIN_REEL_DEFICIT=1
YOUTUBE_VIDEO_TRENDING_ENABLED=0
YOUTUBE_REEL_TRENDING_ENABLED=0
YOUTUBE_API_SEARCH_DAILY_BUDGET_UNITS=4500
YOUTUBE_API_DURATION_DAILY_BUDGET_UNITS=800
YT_CHANNEL_BOOTSTRAP_ENABLED=true
YT_BOOTSTRAP_MAX_PROFILE_AGE_DAYS=2
YT_BOOTSTRAP_MAX_ROWS=32
YT_BOOTSTRAP_BATCH_SIZE=10

# =============================================================================
# PERSONALIZATION
# =============================================================================

# User preference decay rate (0.0-1.0, higher = slower decay)
PREFERENCE_DECAY_FACTOR=0.95

# Topic dominance cap (prevents single topic from dominating feed)
MAX_TOPIC_DOMINANCE=0.40

# =============================================================================
# CONTENT SETTINGS
# =============================================================================

# Maximum age of content to show (hours)
MAX_CONTENT_AGE_HOURS=72

# How long until recency score halves (hours)
RECENCY_HALF_LIFE_HOURS=24

# Default number of items in a playlist
DEFAULT_PLAYLIST_SIZE=50

# Number of articles to pre-cache per user
ARTICLE_CACHE_COUNT=5

# =============================================================================
# CACHE TTLs
# =============================================================================

# Playlist cache duration (seconds)
PLAYLIST_CACHE_TTL_SECONDS=300

# User session snapshot TTL (seconds)
SESSION_SNAPSHOT_TTL_SECONDS=3600

# =============================================================================
# QUOTA LIMITS
# =============================================================================

# Max AI chat messages per user per day
MAX_MESSAGES_PER_DAY=5

# Max AI chat messages per article per user
MAX_MESSAGES_PER_ARTICLE=3

# =============================================================================
# CLUSTERING
# =============================================================================

# Time window for story clustering (hours)
CLUSTER_WINDOW_HOURS=48

# Minimum similarity score to cluster stories
MIN_CLUSTER_SIMILARITY=0.5

# =============================================================================
# TREND SCORING
# =============================================================================

# Weight for cluster size in trend calculation
TREND_CLUSTER_WEIGHT=0.80

# Weight for engagement in trend calculation (capped to prevent gaming)
TREND_ENGAGEMENT_WEIGHT=0.20

# =============================================================================
# PERSONALIZATION WEIGHTS (must sum to 1.0)
# =============================================================================

PERSONALIZATION_TOPIC_WEIGHT=0.35
PERSONALIZATION_ENTITY_WEIGHT=0.30
PERSONALIZATION_SOURCE_WEIGHT=0.20
PERSONALIZATION_FORMAT_WEIGHT=0.15

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Features can be toggled via environment OR Redis (Redis takes priority)
# Redis keys: blips:feature:{name} with value "true" or "false"
# To update instantly without redeploy: PUT /api/v1/admin/flags/{name}

# Content ingestion (articles from RSS, videos from YouTube)
FEATURE_INGESTION_ENABLED=true

# AI summarization of content
FEATURE_SUMMARIZATION_ENABLED=true

# AI chat feature
FEATURE_CHAT_ENABLED=false

# Reels/short video content
FEATURE_REELS_ENABLED=true

# Long-form video content
FEATURE_VIDEOS_ENABLED=true

# Content clustering/story grouping
FEATURE_CLUSTERING_ENABLED=true

# Personalization/recommendations
FEATURE_PERSONALIZATION_ENABLED=true

# Discovery signal ingestion
FEATURE_SIGNALS_ENABLED=true

# Promotion / editorial auto-promotion logic
FEATURE_PROMOTION_ENABLED=true

# Queue AI summarization through the outbox immediately on promotion (event-driven).
# ai_retry_job remains active as a safety-net for retries and failures.
FEATURE_EVENT_DRIVEN_AI_ENABLED=true

# Queue promotion evaluation through the outbox immediately on ingestion (event-driven).
# promotion_job remains active as a safety-net.
FEATURE_EVENT_DRIVEN_PROMOTION_ENABLED=true

# Serve-time hybrid reranking for videos/reels
FEATURE_VIDEO_HYBRID_RERANK_ENABLED=true

# Auto-promote items that would otherwise enter editorial review as CANDIDATE.
# Default is false; set true only when you intentionally want review bypassed.
AUTO_APPROVE_REVIEW_CONTENT=false

# =============================================================================
# EVENT-DRIVEN PIPELINE
# =============================================================================

# Enable continuous content event worker threads (replaces 1-min APScheduler tick).
# Set true to drop outbox dispatch latency from ~1 min to ~1 s.
CONTENT_EVENT_THREADS_ENABLED=true

# Default batch size for content event worker threads (all types except AI summary).
CONTENT_EVENT_BATCH_SIZE=50

# Poll interval (seconds) when the outbox is empty.
CONTENT_EVENT_POLL_SECONDS=1.0

# Batch cap for the AI summary worker thread. Limits to ~300 events/min,
# safely under gpt-5-nano 500 RPM / 200K TPM limits.
CONTENT_EVENT_AI_BATCH_SIZE=5

# =============================================================================
# DATABASE / REDIS TUNING
# =============================================================================

DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# LLM / EXTERNAL APIS
# =============================================================================

LLM_REQUEST_TIMEOUT=30
LLM_DAILY_COST_CEILING=5.0
YOUTUBE_API_KEY=

# =============================================================================
# IMAGE PLACEHOLDER
# =============================================================================

# Minimum minutes after first image verification attempt before applying the
# source-branded SVG placeholder fallback. Reduced from 30 to 5 so articles
# with unrecoverable images reach READY faster.
ARTICLE_IMAGE_PLACEHOLDER_MIN_AGE_MINUTES=5

# =============================================================================
# EXTRACTION HARDENING
# =============================================================================

EXTRACTION_ENABLED=true
EXTRACTION_CONNECT_TIMEOUT=10.0
EXTRACTION_READ_TIMEOUT=20.0
EXTRACTION_MAX_RETRIES=3
EXTRACTION_BACKOFF_BASE=1.5
EXTRACTION_DOMAIN_MIN_INTERVAL=1.0
EXTRACTION_MIN_TEXT_WORDS=100
EXTRACTION_IDEAL_TEXT_WORDS=300
SOURCE_HEALTH_DEGRADED_THRESHOLD=0.3
