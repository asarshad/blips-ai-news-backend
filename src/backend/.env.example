# Blips Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real values - it contains secrets

# =============================================================================
# REQUIRED - Core Infrastructure
# =============================================================================

# Database connection (Render Postgres or local)
DATABASE_URL=postgresql://user:password@localhost:5432/blips

# Redis connection (Render Redis or local)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# REQUIRED - LLM Provider
# =============================================================================

# Which LLM provider to use: "openai" or "mistral"
LLM_PROVIDER=openai

# OpenAI Configuration
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Mistral Configuration (alternative to OpenAI)
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment: dev, prod
ENV=dev

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# SECURITY
# =============================================================================

# Admin API key for /admin and /debug routes (required, fail-closed if empty)
ADMIN_API_KEY=your-admin-api-key-here

# Enable debug diagnostic routes (default: false in prod)
DEBUG_ROUTES_ENABLED=true

# Enable Swagger UI + ReDoc interactive docs (default: false in prod)
DOCS_ENABLED=true

# Comma-separated list of CORS allowed origins (empty = capacitor://localhost only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=10/minute

# =============================================================================
# INGESTION SETTINGS
# =============================================================================

# How often to fetch new content (hours)
NEWS_FETCH_INTERVAL_HOURS=3

# Minutes between fetch intervals (finer control)
NEWS_FETCH_INTERVAL_MINUTES=30

# Maximum items to process per ingestion run
MAX_ITEMS_PER_RUN=100

# How far back to look for playlist updates (hours)
PLAYLIST_LOOKBACK_HOURS=48

# Video fetch interval (minutes)
VIDEO_FETCH_INTERVAL_MINUTES=60

# =============================================================================
# PERSONALIZATION
# =============================================================================

# User preference decay rate (0.0-1.0, higher = slower decay)
PREFERENCE_DECAY_FACTOR=0.95

# Topic dominance cap (prevents single topic from dominating feed)
MAX_TOPIC_DOMINANCE=0.40

# =============================================================================
# CONTENT SETTINGS
# =============================================================================

# Maximum age of content to show (hours)
MAX_CONTENT_AGE_HOURS=72

# How long until recency score halves (hours)
RECENCY_HALF_LIFE_HOURS=24

# Default number of items in a playlist
DEFAULT_PLAYLIST_SIZE=50

# Number of articles to pre-cache per user
ARTICLE_CACHE_COUNT=50

# Maximum summary length in characters
MAX_SUMMARY_LENGTH=280

# =============================================================================
# CACHE TTLs
# =============================================================================

# Playlist cache duration (seconds)
PLAYLIST_CACHE_TTL_SECONDS=300

# User session snapshot TTL (seconds)
SESSION_SNAPSHOT_TTL_SECONDS=3600

# =============================================================================
# QUOTA LIMITS
# =============================================================================

# Max AI chat messages per user per day
MAX_MESSAGES_PER_DAY=50

# Max AI chat messages per article per user
MAX_MESSAGES_PER_ARTICLE=10

# =============================================================================
# CLUSTERING
# =============================================================================

# Time window for story clustering (hours)
CLUSTER_WINDOW_HOURS=48

# Minimum similarity score to cluster stories
MIN_CLUSTER_SIMILARITY=0.5

# =============================================================================
# TREND SCORING
# =============================================================================

# Weight for cluster size in trend calculation
TREND_CLUSTER_WEIGHT=0.80

# Weight for engagement in trend calculation (capped to prevent gaming)
TREND_ENGAGEMENT_WEIGHT=0.20

# =============================================================================
# PERSONALIZATION WEIGHTS (must sum to 1.0)
# =============================================================================

PERSONALIZATION_TOPIC_WEIGHT=0.35
PERSONALIZATION_ENTITY_WEIGHT=0.30
PERSONALIZATION_SOURCE_WEIGHT=0.20
PERSONALIZATION_FORMAT_WEIGHT=0.15

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Features can be toggled via environment OR Redis (Redis takes priority)
# Redis keys: blips:feature:{name} with value "true" or "false"
# To update instantly without redeploy: PUT /api/v1/admin/flags/{name}

# Content ingestion (articles from RSS, videos from YouTube)
FEATURE_INGESTION_ENABLED=true

# AI summarization of content (requires LLM API)
# DEFAULT: false in prod (LLM costs), true in dev
FEATURE_SUMMARIZATION_ENABLED=false

# Reels/short video content
FEATURE_REELS_ENABLED=true

# Long-form video content
FEATURE_VIDEOS_ENABLED=true

# Content clustering/story grouping
FEATURE_CLUSTERING_ENABLED=true

# Personalization/recommendations
FEATURE_PERSONALIZATION_ENABLED=true

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# Enable scheduler in this process (set to false for web API, true for worker)
SCHEDULER_ENABLED=true

# Maximum LLM calls per job run (prevents runaway costs)
MAX_LLM_CALLS_PER_RUN=50

# Delay between LLM calls in seconds (rate limiting)
LLM_RATE_LIMIT_DELAY=0.5